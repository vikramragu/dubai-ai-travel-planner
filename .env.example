# Copy to .env and fill in what you need. Empty values are treated as "not set".

# ---------------------------------------------------------------- LLM
# Default: Groq gpt-oss-120b for the orchestrator, destination, logistics and budget agents,
# Gemini for the reviewer. Providers: groq | google_genai | anthropic | openai | ollama
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
# Optional per-role overrides (fall back to LLM_PROVIDER / LLM_MODEL)
LLM_PROVIDER_ORCHESTRATOR=
LLM_PROVIDER_DESTINATION=
LLM_PROVIDER_LOGISTICS=
LLM_PROVIDER_BUDGET=
LLM_PROVIDER_REVIEW=google_genai
LLM_MODEL_ORCHESTRATOR=
LLM_MODEL_DESTINATION=
LLM_MODEL_LOGISTICS=
LLM_MODEL_BUDGET=
LLM_MODEL_REVIEW=gemini-3.5-flash-lite
GROQ_API_KEY=                    # https://console.groq.com/keys
GOOGLE_API_KEY=                  # Gemini API key, https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Client limits (free tiers are small: Groq allows 8,000 tokens/min for gpt-oss-120b)
# LLM_TIMEOUT_S=60
# LLM_MAX_RETRIES=2
# LLM_MAX_TOKENS=1500           # Groq output cap, reasoning included
# LLM_REASONING_EFFORT=low      # gpt-oss on Groq: low | medium | high

# ---------------------------------------------------------------- Data (free sources only)
DATA_MODE=local                  # local | hybrid | live
DB_PATH=data/dubai.sqlite
USE_OVERPASS=true
OVERPASS_URL=https://overpass-api.de/api/interpreter
USE_OSRM=true
OSRM_CAR_URL=https://router.project-osrm.org        # public demo server: light use only
OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
# EXTERNAL_CALL_BUDGET=40       # max network calls per run in hybrid mode (cache hits are free)
# MIN_REQUEST_INTERVAL_S=1      # per host, for fair use
USE_OPEN_METEO=true
AMADEUS_CLIENT_ID=               # optional, free test environment only
AMADEUS_CLIENT_SECRET=

# ---------------------------------------------------------------- Planning
MAX_REVISIONS=3
CONTINGENCY_PCT=10
# AED per unit; USD/SAR are pegged, others approximate. JSON, e.g. {"USD":3.6725,"EUR":4.0}
# CURRENCY_RATES=

# ---------------------------------------------------------------- Misc
CACHE_DIR=.cache
LOG_LEVEL=INFO
